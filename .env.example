# Required: Fish Audio (JARVIS's voice)
# On Windows it is optional: without it he speaks with the system's own voice.
FISH_API_KEY=your-fish-audio-api-key-here

# Optional (Windows): the fallback voice used when FISH_API_KEY is not set.
# Any installed SAPI voice name; "false" below turns the fallback off (text only).
# JARVIS_WINDOWS_VOICE=Microsoft David Desktop
# JARVIS_WINDOWS_TTS=true

# JARVIS's brain is a Claude Code process running on YOUR Claude subscription.
# Install Claude Code (2.1.224+) and log in with `claude` — no Anthropic API
# key is needed for anything, and any ANTHROPIC_* variable set here is
# deliberately hidden from the brain so it can only use your login.

# Optional: which model the brain runs (default sonnet; always passed explicitly)
# JARVIS_BRAIN_MODEL=sonnet

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=London
# WEATHER_LATITUDE=51.5072
# WEATHER_LONGITUDE=-0.1276
# WEATHER_UNIT=fahrenheit  # or "celsius"

# Optional: the learning system's local model. Any OpenAI-compatible server —
# Ollama, LM Studio, llama.cpp's llama-server, vLLM. Learning is off until a
# model is named; with none, JARVIS still records failures for later.
# JARVIS_LOCAL_LLM_MODEL=qwen2.5-coder:7b
# JARVIS_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# JARVIS_LOCAL_LLM_API_KEY=            # only if your server wants one
# JARVIS_LOCAL_LLM_TIMEOUT=120
#
# Off (default): every lesson the model proposes waits for your approval.
# On: run lessons go on trial at once and are kept or retired on results;
# anything that reads like an instruction, brain lessons, and new skills still
# wait for you.
# JARVIS_LEARNING_AUTO_APPLY=false

# Market study (market.py): JARVIS follows the market ETFs and your watchlist,
# every few minutes while it is open, and re-tests his pattern library after
# each close. Read-only market data from a free Alpaca account (paper keys
# work; the free consolidated feed is 15 minutes delayed). Off without keys.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# JARVIS_MARKET_WATCHLIST=AAPL,MSFT,NVDA     # first start only; then edit it in the dashboard or by voice
# JARVIS_MARKET_INTERVAL_MIN=15              # 5-120, while the market is open
# JARVIS_MARKET=1                            # 0 switches the study off
# Optional: MegaEmpire, the trading bots JARVIS studies. READ-ONLY — JARVIS
# never trades, changes risk, or answers MegaMind's /approve.
# MegaMind's dashboard (its `dashboard:` host/port in config/megamind.yaml):
# JARVIS_EMPIRE_URL=http://127.0.0.1:8765
# The bots' outcomes.jsonl files or folders, comma separated, optionally named:
# JARVIS_EMPIRE_OUTCOMES=fable=C:/fable/data,orb_elite=C:/orb_elite/state/feedback,revbot=C:/revbot/state/performance,nexus_alpha=C:/nexus_alpha/logs
# How often to re-read them, in minutes (default 15):
# JARVIS_EMPIRE_STUDY_MIN=15
